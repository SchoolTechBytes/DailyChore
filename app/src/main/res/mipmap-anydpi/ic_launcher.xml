<?xml version="1.0" encoding="utf-8"?>
<!-- App icon for Android 7.x (API 24-25), which doesn't support adaptive icons.
     Android 8+ uses mipmap-anydpi-v26/ic_launcher.xml instead. "anydpi" wins over the
     old density-specific .webp robot icons in mipmap-hdpi etc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
